# ============ 后端（backend/ 下运行 uvicorn 时读取，或复制为根目录 .env）============
# SQLite 数据库文件路径（相对运行目录）
DATABASE_URL=sqlite:///./jarvis.db

# 允许的前端来源（逗号分隔，用于 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ LLM Gateway（Phase 1）============
# 供应商：openai（OpenAI 兼容 API）/ fake（本地模拟，无需 Key，用于演示与测试）
LLM_PROVIDER=openai

# API Key：不要提交真实 Key 到仓库。留空时应用正常启动，
# 仅「发送消息」接口返回 LLM_NOT_CONFIGURED。
LLM_API_KEY=

# 模型名与外部调用超时（秒）
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# 可选：OpenAI 兼容端点（自托管网关 / 其他供应商），留空使用官方端点
# LLM_BASE_URL=

# ============ Reminder Worker（Phase 3）============
# 轮询间隔（秒）、每批处理上限、领取租约时长（秒）、最大尝试次数
# 非法值（非整数/越界）会在应用启动时给出清晰配置错误
REMINDER_POLL_INTERVAL_SECONDS=5
REMINDER_BATCH_SIZE=50
REMINDER_LEASE_SECONDS=60
REMINDER_MAX_ATTEMPTS=5

# ============ 前端（复制为 frontend/.env.local）============
# 后端 API 地址。生产环境部署时必须显式配置，不要使用默认值。
VITE_API_BASE_URL=http://localhost:8000

# 不要在本文件中填写任何 API Key / 密钥

# ============ Microsoft Calendar (Phase 9A, read-only public client) ============
# Entra: organizational + personal accounts; Mobile/Desktop redirect below.
# Set real client ID only in your local environment. No client secret required.
JARVIS_MICROSOFT_CLIENT_ID=
JARVIS_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
JARVIS_MICROSOFT_GRAPH_BASE=https://graph.microsoft.com/v1.0
JARVIS_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
# Delegated permission: Calendars.Read. Cache: %LOCALAPPDATA%/JARVIS/auth (DPAPI).
# Run one backend process on loopback. OAuth flow memory expires after 10 minutes.
